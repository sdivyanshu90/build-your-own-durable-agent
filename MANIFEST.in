include LICENSE
include README.md
include alembic.ini
include docker-compose.yml
include Dockerfile
include Makefile
include requirements.lock
include .env.example
recursive-include docs *.md
recursive-include examples *
recursive-include migrations *.py *.mako
recursive-include scripts *.py
recursive-include tests *.py *.md *.toml *.yaml *.html *.txt
global-exclude *.py[cod]
global-exclude .coverage
global-exclude CACHEDIR.TAG
prune artifacts
prune build
prune dist
prune tests/fixtures/sample_service/.pytest_cache
