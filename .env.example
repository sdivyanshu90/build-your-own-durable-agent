DURABLE_AGENT_DATABASE_URL=sqlite+aiosqlite:///./durable-agent.db
DURABLE_AGENT_SYNC_DATABASE_URL=sqlite:///./durable-agent.db
DURABLE_AGENT_ARTIFACT_DIRECTORY=./artifacts
DURABLE_AGENT_REPOSITORY_ROOT=.
DURABLE_AGENT_LOG_LEVEL=INFO
DURABLE_AGENT_LLM_PROVIDER=deterministic
DURABLE_AGENT_MODEL_NAME=offline-baseline
DURABLE_AGENT_MODEL_CONTEXT_LIMIT=32768
DURABLE_AGENT_RESERVED_OUTPUT_TOKENS=4096
DURABLE_AGENT_MAXIMUM_CONCURRENCY=1
DURABLE_AGENT_CHECKPOINT_RETENTION_COUNT=100
DURABLE_AGENT_REPOSITORY_DRIFT_POLICY=REINDEX
DURABLE_AGENT_NETWORK_ACCESS=false
DURABLE_AGENT_ALLOW_FILE_WRITES=false
DURABLE_AGENT_ALLOW_PATCH=false
DURABLE_AGENT_ALLOW_SHELL=false
DURABLE_AGENT_REQUIRE_API_AUTHENTICATION=false
DURABLE_AGENT_API_AUTH_TOKEN=
DURABLE_AGENT_API_ALLOWED_OWNERS=[]
